{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menologaritmo",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
